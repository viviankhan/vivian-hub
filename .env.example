# Copy this file to .env.local and fill in your Supabase credentials
# Never commit .env.local to GitHub — it's in .gitignore
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: only if you generate your OWN VAPID keys for background push.
# A working public key is already baked into the app, so you can leave this
# blank unless you regenerate the pair (see PUSH_SETUP.md). This is the PUBLIC
# key only — the private key lives as a Supabase Edge Function secret, never here.
# VITE_VAPID_PUBLIC_KEY=
